# ---------------------------------------------------------------------------
# Claude Quant — Freqtrade Trading Engine Dockerfile
# ---------------------------------------------------------------------------
# Based on the official Freqtrade image with custom strategy, config,
# and user_data overlay.
# ---------------------------------------------------------------------------

FROM freqtradeorg/freqtrade:stable

LABEL maintainer="Claude Quant <claude-quant@localhost>"
LABEL description="Freqtrade trading engine for Claude Quant"

# Copy custom Freqtrade configuration
COPY config/freqtrade/config.json /freqtrade/user_data/config.json

# Copy custom strategies
COPY user_data/strategies/ /freqtrade/user_data/strategies/

# Copy FreqAI models (if any)
COPY user_data/freqaimodels/ /freqtrade/user_data/freqaimodels/

# Create required directories
RUN mkdir -p \
        /freqtrade/user_data/data \
        /freqtrade/user_data/logs \
        /freqtrade/user_data/backtest_results \
        /freqtrade/user_data/hyperopt_results

# Environment defaults
ENV FREQTRADE__TRADING_MODE=futures \
    FREQTRADE__DRY_RUN=true

# Health check — query the Freqtrade API
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -sf http://localhost:8080/api/v1/ping || exit 1

# Entry point: Freqtrade trade mode with config
# The strategy can be overridden via environment or docker-compose
ENTRYPOINT ["freqtrade"]
CMD [ \
    "trade", \
    "--config", "/freqtrade/user_data/config.json", \
    "--strategy", "ClaudeQuantAdaptive", \
    "--strategy-path", "/freqtrade/user_data/strategies" \
]
